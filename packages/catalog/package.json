{
  "name": "@nextmoe/edit-ui-catalog",
  "version": "0.3.1",
  "description": "Field presets for the NextMoe catalog editing API — a tested EditFieldConfig table covering every field the editing engine registers, so a site does not have to rediscover each field's control, enum vocabulary and element shape.",
  "type": "module",
  "keywords": [
    "nextmoe",
    "edit-ui",
    "catalog",
    "schema",
    "preset"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-moe/nextmoe-edit-ui.git",
    "directory": "packages/catalog"
  },
  "homepage": "https://github.com/next-moe/nextmoe-edit-ui#readme",
  "bugs": "https://github.com/next-moe/nextmoe-edit-ui/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nextmoe/edit-ui-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  }
}
