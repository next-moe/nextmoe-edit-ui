{
  "name": "nextmoe-edit-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "@nextmoe/edit-ui — the schema-driven edit component family of the NextMoe ecosystem. Framework-free core + a Vue render layer + a Nuxt auto-import module.",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "pnpm -r --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2"
}
